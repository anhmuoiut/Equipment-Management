# Copy to .env.local for local development. On Vercel, set the same three names under
# Project Settings > Environment Variables (Production and Preview are separate: see docs/DEPLOY.md).
#
# All three values must come from the SAME Supabase project (Project Settings > API); a mix gives "Invalid API key".

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Public by design (it ends up in the browser bundle). Safe because every table has RLS on and no policies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key: sb_publishable_...>
# Legacy fallback if the project still uses the old anon JWT key: NEXT_PUBLIC_SUPABASE_ANON_KEY

# SECRET. Server only: NEVER give it a NEXT_PUBLIC_ prefix and never commit it.
# Read in exactly one place, lib/supabase/admin.ts ('server-only'), plus the two CLI scripts in scripts/.
SUPABASE_SERVICE_ROLE_KEY=<secret key: sb_secret_...  (or the legacy service_role JWT)>
